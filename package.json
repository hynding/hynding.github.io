{
  "name": "hynding-site",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/build-vault.ts",
    "build": "next build",
    "vault:init": "tsx scripts/build-vault.ts --init",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:leak": "tsx scripts/check-no-leak.ts",
    "build:e2e": "VAULT_PRIVATE_FILE=$PWD/tests/fixtures/resume.private.yaml VAULT_PASSPHRASE_RECRUITER=test-recruiter-passphrase VAULT_PASSPHRASE_FULL=test-full-passphrase npm run build",
    "test:e2e": "npm run build:e2e && playwright test"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "next": "^15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "serve": "^14.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
